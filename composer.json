{
    "name": "uxi360/first-image",
    "description": "Get the first image from a Redactor or CKEditor field, with optional image transforms.",
    "type": "craft-plugin",
    "version": "3.0.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "first image"
    ],
    "support": {
        "docs": "https://github.com/bhashkar007/first-image/blob/master/README.md",
        "issues": "https://github.com/bhashkar007/first-image/issues"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "UXI360 InfoTech",
            "homepage": "https://uxi360.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "uxi360\\firstimage\\": "src/"
        }
    },
    "extra": {
        "name": "First Image",
        "handle": "first-image",
        "changelogUrl": "https://raw.githubusercontent.com/bhashkar007/first-image/master/CHANGELOG.md",
        "class": "uxi360\\firstimage\\FirstImage"
    }
}
